# ==================================================
# Analisador de Exames Médicos com IA (Gemini)
# Copie este arquivo para .env e preencha os valores
# ==================================================

# Chave da API do Google Gemini (OBRIGATÓRIO)
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=sua_chave_gemini_aqui
# Alias opcional se você já usa a nomenclatura da documentação do Google:
# GOOGLE_API_KEY=sua_chave_gemini_aqui

# Modelo Gemini a utilizar
# Opções disponíveis (2026):
#   gemini-2.5-flash        → Estável, rápido e econômico (recomendado)
#   gemini-2.5-flash-lite   → Mais leve, ideal para alto volume
#   gemini-3-pro-preview    → Gemini 3, máxima capacidade (preview)
#   gemini-3-flash-preview  → Gemini 3, versão rápida (preview)
GEMINI_MODEL=gemini-2.5-flash
# Modelos Gemini de fallback (sobrecarga/limite do principal), em ordem, CSV.
# Mantenha só modelos ativos: um modelo descontinuado aqui devolve 404 e
# esconde o erro original.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# Após erro 401/403 do Gemini, usa só o Claude por este tempo (segundos).
GEMINI_CIRCUIT_COOLDOWN_SECONDS=600

# Chave da Anthropic — habilita a análise dual (Gemini + Claude + síntese de
# consenso). Sem ela, o laudo sai só do Gemini.
ANTHROPIC_API_KEY=
# Modelo Claude da análise independente e da síntese. O rótulo exibido no
# laudo e o preço estimado acompanham o modelo configurado.
CLAUDE_MODEL=claude-sonnet-4-6

# Performance da análise
# ANALYSIS_BUDGET_SECONDS prioriza resposta em até 90s. Ativar o atlas PDF
# (INCLUDE_REFERENCE_PDF=true) adiciona o upload do PDF a cada análise, o que
# pode empurrar o tempo de resposta para perto (ou além) desse orçamento —
# reavalie ANALYSIS_BUDGET_SECONDS se notar timeouts após ativar.
ANALYSIS_BUDGET_SECONDS=90
INCLUDE_REFERENCE_PDF=true
GEMINI_HTTP_TIMEOUT_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=6144
CLAUDE_ANALYSIS_TIMEOUT_SECONDS=45
CLAUDE_SYNTHESIS_TIMEOUT_SECONDS=25
CLAUDE_ANALYSIS_MAX_TOKENS=4096
CLAUDE_SYNTHESIS_MAX_TOKENS=4096
# Tempo mínimo (s) que precisa restar no orçamento para tentar a síntese.
SYNTHESIS_RESERVE_SECONDS=12

# Imagens enviadas aos modelos: reduzidas para no máximo este lado maior (px)
# e este tamanho (bytes; a API do Claude recusa imagens > 5 MB). Imagens já
# dentro dos limites são enviadas sem alteração.
MAX_IMAGE_EDGE_PX=1568
MAX_IMAGE_BYTES=3932160

# Detecção visual da região anatômica (usada só quando nome do arquivo e
# descrição não identificam a região). DETECTION_RESERVE_RATIO é a fração do
# ANALYSIS_BUDGET_SECONDS que precisa restar para valer a chamada extra;
# DETECTION_TIMEOUT_SECONDS é o teto dessa chamada (mantenha acima de 3s,
# abaixo disso a checagem de deadline interna aborta antes de chamar a API).
DETECTION_RESERVE_RATIO=0.7
DETECTION_TIMEOUT_SECONDS=6

# Configurações do Flask
FLASK_SECRET_KEY=troque-por-uma-chave-secreta-aleatoria

# Prontuário de pacientes: chave que cifra nome e CPF no banco (Fernet).
# Obrigatória em produção (sem ela o cadastro de pacientes fica desligado).
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NUNCA troque depois de ter pacientes cadastrados: os dados antigos ficam ilegíveis.
# Guarde uma cópia em local seguro (cofre de senhas). Defina também no worker.
PRONTUARIO_ENCRYPTION_KEY=
FLASK_DEBUG=false

# Nível de log (DEBUG, INFO, WARNING, ERROR). Padrão: INFO
LOG_LEVEL=INFO

# PostHog (eventos de produto, exceções e métricas das chamadas de IA).
# Vazio = integração desligada. O token "phc_" é público (só envia eventos).
# Nunca chegam ao PostHog: prompt, imagens, laudo, e-mail ou nome — ver
# web/posthog.py. Defina também no ambiente do worker.
POSTHOG_PROJECT_TOKEN=phc_seu_token_publico_aqui
POSTHOG_HOST=https://us.i.posthog.com

# ──────────────────────────────────────────
# Custo estimado por análise (tokens × preço) e orçamento de gasto diário
# ──────────────────────────────────────────

# Preços em USD por 1 milhão de tokens — aproximados, ajuste conforme a tabela
# vigente do provedor (mudam com frequência, por isso são configuráveis).
# O preço é escolhido pela família do modelo (prefixo): "claude-sonnet-*" usa
# CLAUDE_SONNET_*, etc. Modelo sem família conhecida é estimado pelo teto da
# família (Gemini Pro / Claude Opus) — nunca como grátis.
GEMINI_2_5_FLASH_LITE_INPUT_PRICE_PER_1M=0.10
GEMINI_2_5_FLASH_LITE_OUTPUT_PRICE_PER_1M=0.40
GEMINI_2_5_PRO_INPUT_PRICE_PER_1M=1.25
GEMINI_2_5_PRO_OUTPUT_PRICE_PER_1M=10.00
GEMINI_2_5_FLASH_INPUT_PRICE_PER_1M=0.30
GEMINI_2_5_FLASH_OUTPUT_PRICE_PER_1M=2.50
GEMINI_2_0_FLASH_INPUT_PRICE_PER_1M=0.10
GEMINI_2_0_FLASH_OUTPUT_PRICE_PER_1M=0.40
GEMINI_2_0_FLASH_LITE_INPUT_PRICE_PER_1M=0.075
GEMINI_2_0_FLASH_LITE_OUTPUT_PRICE_PER_1M=0.30
CLAUDE_SONNET_INPUT_PRICE_PER_1M=3.00
CLAUDE_SONNET_OUTPUT_PRICE_PER_1M=15.00
CLAUDE_HAIKU_INPUT_PRICE_PER_1M=1.00
CLAUDE_HAIKU_OUTPUT_PRICE_PER_1M=5.00
CLAUDE_OPUS_INPUT_PRICE_PER_1M=5.00
CLAUDE_OPUS_OUTPUT_PRICE_PER_1M=25.00

# Limites de gasto diário em USD (fuso UTC). 0 desativa o limite.
# TRIAL: protege o uso gratuito de abuso (habilitado por padrão).
# GLOBAL: teto agregado de todas as análises (trial + premium + API).
# USER: teto por usuário identificado (e-mail premium ou X-API-Key da rota /api/analyze).
TRIAL_DAILY_COST_BUDGET_USD=3.00
GLOBAL_DAILY_COST_BUDGET_USD=0
USER_DAILY_COST_BUDGET_USD=0
# Onde ficam os contadores: Redis (RATELIMIT_STORAGE_URI ou
# ANALYSIS_QUEUE_REDIS_URL); sem Redis, a tabela gastos_diarios do Supabase
# (migration 2026-10-13-gastos-diarios.sql); sem nenhum dos dois, memória do
# processo — que na Vercel NÃO limita nada de verdade.

# Análises gratuitas por IP por dia (0 desativa). O contador da página do
# trial é só visual; este é o limite que vale.
TRIAL_MAX_PER_IP_PER_DAY=5

# Alerta de qualidade: "consenso rápido" = laudo de um só modelo porque o outro
# ou a síntese não coube no orçamento de tempo. Acima desta taxa no dia (com o
# mínimo de análises), gera um log de erro (vai para o Sentry) — uma vez por dia.
# Histórico em /admin/custos.
CONSENSUS_FALLBACK_ALERT_RATIO=0.3
CONSENSUS_FALLBACK_ALERT_MIN_ANALYSES=10

# Cache do resultado completo de uma análise por hash da imagem + descrição,
# evitando reprocessar (e recobrar) um upload idêntico.
ANALYSIS_RESULT_CACHE_ENABLED=true
ANALYSIS_RESULT_CACHE_TTL_SECONDS=86400
# Máximo de laudos guardados nesse cache (os mais antigos saem primeiro).
ANALYSIS_RESULT_CACHE_MAX_ENTRIES=500

# Desempenho por requisição
# Por quantos segundos a versão de sessão do cliente fica em cache (evita uma
# consulta ao Supabase por página). Revogações feitas por outra instância
# (estorno via webhook, troca de senha) valem em até esse tempo.
SESSION_CACHE_TTL_SECONDS=60
# Log de acesso (logs_acesso) gravado em segundo plano; 0 = síncrono.
ACCESS_LOG_ASYNC=1
ACCESS_LOG_QUEUE_MAX=1000

# ──────────────────────────────────────────
# Fila de análise assíncrona (RQ + Redis)
# ──────────────────────────────────────────
#
# Sem um Redis real configurado aqui, as rotas de análise caem no caminho
# síncrono existente (nada muda). Com Redis configurado, elas enfileiram o
# trabalho e respondem na hora — mas só são de fato processadas se houver um
# worker rodando (`python worker.py`), separado do processo web. Veja
# "Fila assíncrona" no README para detalhes de deploy.
#
# Se vazio, cai de volta para RATELIMIT_STORAGE_URI (se for um Redis real).
ANALYSIS_QUEUE_REDIS_URL=
ANALYSIS_QUEUE_NAME=analysis
ANALYSIS_JOB_TIMEOUT_SECONDS=180
ANALYSIS_JOB_RESULT_TTL_SECONDS=3600

# Limite de requisições para os endpoints de polling de status (baratos —
# só leem o Redis — por isso um limite bem mais generoso que os de análise).
STATUS_POLL_RATE_LIMIT=60 per minute

# ──────────────────────────────────────────
# Sentry (monitoramento de erros em produção)
# Deixe SENTRY_DSN vazio para desativar. Obtenha o DSN em sentry.io → Settings → Client Keys
# ──────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0

# Acesso admin para testes internos
# Local: se ADMIN_KEY não estiver definida, uma chave temporária é gerada a cada
# execução e impressa no log de inicialização (nível WARNING) — use-a para acessar
# /admin/entrar?key=... durante o desenvolvimento.
# Produção/Vercel: defina ADMIN_KEY com um valor secreto e estável nas variáveis do projeto.
ADMIN_KEY=defina-uma-chave-secreta-aqui

# Rate limiting
# Em produção, use Redis/Upstash. Ex: rediss://default:SENHA@host:6379
RATELIMIT_STORAGE_URI=memory://
TRIAL_RATE_LIMIT=10 per hour
API_RATE_LIMIT=60 per hour
LOGIN_RATE_LIMIT=10 per 15 minutes

# IP real do cliente (rate limit, orçamento, logs). Na Vercel é lido de
# X-Real-IP automaticamente. Fora dela, atrás de N proxies SEUS (nginx,
# Railway, Render), defina N — o X-Forwarded-For enviado pelo cliente nunca é
# confiado diretamente. Sem proxy na frente, deixe 0.
TRUSTED_PROXY_HOPS=0
ACESSO_RATE_LIMIT=5 per hour
ACCOUNT_EXPORT_RATE_LIMIT=10 per hour
ACCOUNT_DELETE_RATE_LIMIT=5 per hour

# ──────────────────────────────────────────
# API REST (/api/analyze)
# ──────────────────────────────────────────
# Chaves aceitas no cabeçalho X-API-Key, separadas por vírgula. Vazio = API
# desligada (toda requisição recebe 401). Gere cada uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Toda análise via API usa as chaves Gemini/Anthropic do servidor e conta no
# orçamento de custo (USER_DAILY_COST_BUDGET_USD vale por chave).
API_ACCESS_KEYS=

# ──────────────────────────────────────────
# E-mail transacional (link de recuperação de acesso em /acesso)
# ──────────────────────────────────────────
# Sem SMTP_HOST/SMTP_FROM e APP_BASE_URL, /acesso não envia link e orienta o
# cliente a fazer login com senha ou falar com o suporte — o acesso NUNCA é
# liberado só por digitar o e-mail.
# Porta 465 = SSL implícito; demais portas = STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Three Health <nao-responda@seudominio.com.br>
# URL pública do app usada nos links enviados por e-mail (sem barra no fim).
# Obrigatória em produção: o link nunca é montado a partir do cabeçalho Host.
APP_BASE_URL=https://app.seudominio.com.br

# Porta da aplicação (padrão: 5000)
PORT=5000

# ──────────────────────────────────────────
# Validação de e-mail no cadastro
# ──────────────────────────────────────────

# Checagem de DNS/MX do domínio no checkout (1 = ligada, padrão).
# Só rejeita quando o DNS responde de forma conclusiva que o domínio não
# existe ou não recebe e-mail; timeout/erro de rede deixa o cadastro passar.
EMAIL_MX_CHECK=1

# Timeout (segundos) de cada consulta DNS.
EMAIL_MX_TIMEOUT=3

# Aceitar domínio sem MX que tenha apenas registro A ("MX implícito" da RFC
# 5321). 0 = não aceitar (padrão) — é o que barra domínios parkeados.
EMAIL_MX_IMPLICITO=0

# Domínios extras a bloquear além da lista de descartáveis embutida (CSV).
# Ex: EMAIL_DOMINIOS_BLOQUEADOS=teste.com,exemplo.local
EMAIL_DOMINIOS_BLOQUEADOS=

# ──────────────────────────────────────────
# Integração Asaas (pagamentos)
# Obtenha a chave em: Minha Conta → Integrações → Gerar nova chave
# ──────────────────────────────────────────

# Chave de API do Asaas (OBRIGATÓRIO para pagamentos)
ASAAS_API_KEY=sua_chave_asaas_aqui

# Ambiente: "sandbox" para testes, "production" para produção
ASAAS_ENVIRONMENT=sandbox

# Preço do produto em reais (ex: 97.00)
PRODUCT_PRICE=97.00

# Token de autenticação do webhook Asaas
# Configure o mesmo valor no painel Asaas → Configurações → Notificações
# OBRIGATÓRIO fora do ambiente local: sem ele o webhook responde 503.
ASAAS_WEBHOOK_TOKEN=defina-um-token-secreto-aqui

# ──────────────────────────────────────────
# Integração Supabase (banco de dados)
# ──────────────────────────────────────────

# URL do projeto (visível no painel Supabase → Settings → API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave secreta — acesso total ao banco, use APENAS no backend.
# Painel Supabase → Settings → API Keys → secret key (sb_secret_…), ou a
# legada service_role (JWT). NÃO use a publishable/anon: ela é de front-end e
# esbarra nas policies de RLS.
SUPABASE_SERVICE_KEY=sua_chave_secreta_aqui

# ──────────────────────────────────────────
# Proteções do navegador
# ──────────────────────────────────────────
# Sites autorizados a embutir /trial via iframe (separados por vírgula ou
# espaço). Ex.: https://threehealth.com.br https://www.threehealth.com.br
# Vazio = /trial embutível em qualquer site (comportamento anterior); as
# demais páginas só podem ser embutidas pelo próprio app.
TRIAL_FRAME_ANCESTORS=
# Origens extras aceitas em POSTs (proteção CSRF). O próprio host e
# APP_BASE_URL já são aceitos; use só se servir o app em outro domínio.
CSRF_TRUSTED_ORIGINS=
